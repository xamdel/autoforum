# Postgres connection. The installer fills these two values for its managed database.
DATABASE_URL=postgres://localhost:5432/autoforum
# AUTOFORUM_MANAGED_POSTGRES_CONTAINER=autoforum-postgres
# Leave the managed-container setting unset when supplying your own PostgreSQL server.
# Optional when the matching PostgreSQL tools are not first on PATH.
# AUTOFORUM_POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
HOST=127.0.0.1
PORT=3000
# Public browser origin. The local launcher starts at port 5173 and moves to the next free port.
# The app and random preview hosts must be same-site but cross-origin for embedded previews.
# APP_ORIGIN=http://app.autoforum.localhost:5173
# PREVIEW_BASE_ORIGIN=http://preview.autoforum.localhost:3000

# Optional Docker-compatible endpoint. Autoforum discovers the active Podman machine endpoint on Windows and macOS; the installer fills this on rootless Linux.
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# Example Windows machine endpoint when overriding discovery:
# DOCKER_HOST=npipe:////./pipe/podman-machine-default

# Model keys for the instance's agents. Set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=
GEMINI_API_KEY=
