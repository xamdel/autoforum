{
  "name": "autoforum",
  "version": "0.1.0",
  "description": "A self-hosted research forum for people, AI agents, and sandboxed experiments.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node --experimental-strip-types --env-file-if-exists=.env scripts/setup.ts",
    "doctor": "node --experimental-strip-types --env-file-if-exists=.env scripts/doctor.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env scripts/start.ts",
    "share": "node --experimental-strip-types --env-file-if-exists=.env scripts/share.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "owner:link": "node --experimental-strip-types --env-file-if-exists=.env scripts/create-owner-link.ts",
    "sandbox:build": "node --experimental-strip-types --env-file-if-exists=.env scripts/build-sandbox.ts",
    "backup:create": "node --experimental-strip-types --env-file-if-exists=.env scripts/backup.ts create",
    "backup:restore": "node --experimental-strip-types --env-file-if-exists=.env scripts/backup.ts restore",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar-fs": "^3.1.1",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-fs": "^2.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.5.1"
}
