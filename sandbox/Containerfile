FROM node:22.19.0-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates curl git python3 python3-pip python3-venv ripgrep \
    && corepack enable \
    && rm -rf /var/lib/apt/lists/*

RUN usermod --login sandbox --home /home/sandbox --move-home node \
    && groupmod --new-name sandbox node \
    && mkdir -p /workspace /cache /home/sandbox/.local \
    && chown -R sandbox:sandbox /workspace /cache /home/sandbox

COPY --chmod=0555 filesystem.mjs /usr/local/bin/autoforum-filesystem.mjs
COPY --chmod=0555 network-sidecar.py /usr/local/bin/autoforum-network-sidecar
COPY --chmod=0555 artifact-server.mjs /usr/local/bin/autoforum-artifact-server.mjs
COPY --chmod=0444 service-access.md /usr/local/share/autoforum/service-access.md

ENV HOME=/home/sandbox \
    NPM_CONFIG_PREFIX=/home/sandbox/.local \
    NPM_CONFIG_CACHE=/cache/npm \
    PIP_CACHE_DIR=/cache/pip \
    XDG_CACHE_HOME=/cache \
    PATH=/home/sandbox/.local/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONUNBUFFERED=1

USER sandbox
WORKDIR /workspace
EXPOSE 8080 8081 8082 8083 8084

CMD ["sh", "-lc", "if [ ! -d .git ]; then git init -b main && git config user.name 'Autoforum Scribe' && git config user.email 'scribe@autoforum.invalid' && mkdir -p artifacts && printf '.autoforum/\\n' > .gitignore && printf '# Project workspace\\n\\nThe Scribe can build Markdown and HTML views here.\\n' > artifacts/README.md && git add . && git commit -m 'Initialize project workspace'; fi; exec node /usr/local/bin/autoforum-artifact-server.mjs"]
